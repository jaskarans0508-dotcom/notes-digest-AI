[project]
name = "notes-digest"
version = "0.1.0"
description = "AI-powered CLI that summarizes, tags, and digests a folder of notes using Claude."
readme = "README.md"
requires-python = ">=3.9"
license = { text = "MIT" }
authors = [{ name = "Jaskaran" }]
dependencies = [
    "anthropic>=0.34.0",
]

[project.optional-dependencies]
dev = ["pytest>=7.0"]

[project.scripts]
notes-digest = "notes_digest.cli:main"

[build-system]
requires = ["setuptools>=61.0"]
build-backend = "setuptools.build_meta"

[tool.setuptools.packages.find]
include = ["notes_digest*"]
